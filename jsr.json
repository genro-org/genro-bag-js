{
  "name": "@genro/bag",
  "version": "0.11.1",
  "license": "Apache-2.0",
  "exports": "./src/index.js",
  "publish": {
    "include": [
      "src/**/*.js",
      "src/**/*.d.ts",
      "package.json",
      "README.md",
      "LICENSE",
      "NOTICE",
      "docs/migration-ingestion.md",
      "docs/python-alignment.md"
    ]
  },
  "imports": {
    "@genrojs/tytx": "jsr:@genro/tytx@^0.16.2"
  },
  "nodeModulesDir": "auto",
  "lock": false,
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@genro/*",
      "npm:@jsr/genro__*",
      "jsr:@genro/tytx",
      "npm:@jsr/genro__tytx",
      "npm:@genrojs/*",
      "npm:@genrojs/tytx"
    ]
  }
}
