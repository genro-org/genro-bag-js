{
  "name": "@genrojs/bag",
  "version": "0.10.3",
  "description": "JavaScript port of genro-bag - hierarchical data container",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./devtools": "./src/devtools/index.js",
    "./devtools/html-repr.css": "./src/devtools/html-repr.css"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs/python-alignment.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:coverage": "c8 --reporter=lcov --reporter=text node --test tests/*.test.js"
  },
  "keywords": [
    "bag",
    "hierarchical",
    "xml",
    "builder",
    "genro"
  ],
  "author": "Genropy Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genro-org/genro-bag-js.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@genrojs/tytx": "^0.16.1",
    "@msgpack/msgpack": "^3.1.3",
    "@xmldom/xmldom": "^0.9.12",
    "big.js": "^7.0.1"
  },
  "devDependencies": {
    "c8": "^10.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
